// Vědmák: Pogromca Leszych — Firestore Security Rules
// Autor: Alexandre Basseville
//
// Nasazení: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Pomocná funkce ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Postavy (characters) ───────────────────────────────────────
    // Hráč si může číst a upravovat POUZE svou vlastní postavu.
    // Jiní hráči mohou číst (pro matchmaking a leaderboard), ale ne editovat.
    match /characters/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;  // Smazání postavy není povoleno
    }

    // ── Inventář (inventory) ───────────────────────────────────────
    // Klíč dokumentu je vždy "{uid}_{itemId}" — hráč čte/píše jen své záznamy.
    match /inventory/{docId} {
      allow read:   if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Záznamy soubojů (battles) ──────────────────────────────────
    // Přidat mohou jen přihlášení hráči; číst všichni přihlášení (pro statistiky).
    match /battles/{battleId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.attackerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Chat školy (schoolChat) ─────────────────────────────────────
    // Číst/psát může pouze hráč, jehož school v characters/{uid} odpovídá
    // school uložené ve zprávě. Tím je zaručena izolace chatů škol.
    match /schoolChat/{msgId} {
      allow read: if isAuth()
        && exists(/databases/$(database)/documents/characters/$(request.auth.uid))
        && get(/databases/$(database)/documents/characters/$(request.auth.uid)).data.school
           == resource.data.school;

      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/characters/$(request.auth.uid))
        && get(/databases/$(database)/documents/characters/$(request.auth.uid)).data.school
           == request.resource.data.school
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;

      allow update, delete: if false;
    }

  }
}
